<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grey0.25"
    tools:context=".MainActivity">

    <!-- ===================== TOP BAR (тёмный) ===================== -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/grey6"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="16dp"
        android:paddingBottom="18dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/groupName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_black"
                android:letterSpacing="0.01"
                android:text="КС-26-1_2"
                android:textColor="@color/white"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_medium"
                android:text="Расписание на сегодня"
                android:textColor="@color/grey2"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/updateButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/updateIV"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Обновить расписание"
                android:src="@drawable/update_icon"
                app:tint="@color/yellow3" />
        </FrameLayout>
    </LinearLayout>

    <!-- ===================== SCROLL AREA ===================== -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- ============ DAY PANEL ============ -->
            <LinearLayout
                android:id="@+id/dayPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_fill"
                android:backgroundTint="@color/white"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <View
                    android:layout_width="3dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="14dp"
                    android:background="@color/yellow3" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/dayName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_black"
                        android:text="Понедельник"
                        android:textColor="@color/grey6"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/dayDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"
                        android:text="22 сентября"
                        android:textColor="@color/grey3"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/weekChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_orange"
                    android:fontFamily="@font/inter_black"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="Чётная"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- ============ CARD 1 ============ -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/lessonItem1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/rounded_fill"
                android:backgroundTint="@color/white"
                android:elevation="2dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/lessonId1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFamily="@font/inter_black"
                    android:text="1"
                    android:textColor="@color/yellow3"
                    android:textSize="26sp"
                    app:layout_constraintBottom_toBottomOf="@id/nameTeacherLL1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/nameTeacherLL1" />

                <LinearLayout
                    android:id="@+id/nameTeacherLL1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toStartOf="@id/lessonTime1"
                    app:layout_constraintStart_toEndOf="@id/lessonId1"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/lessonName1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_black"
                        android:maxLines="1"
                        android:text="География"
                        android:textColor="@color/grey6"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/lessonTeacher1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"
                        android:text="Марков Д.Д."
                        android:textColor="@color/grey3"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/lessonTime1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/inter_black"
                    android:text="11:40 — 13:10"
                    android:textColor="@color/grey5"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/line1"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/grey0.5"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/nameTeacherLL1" />

                <TextView
                    android:id="@+id/note1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/inter_medium"
                    android:lineSpacingExtra="2dp"
                    android:text="Заметка"
                    android:textColor="@color/grey4"
                    android:textSize="14sp"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/line1" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ============ CARD 2 ============ -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/lessonItem2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/rounded_fill"
                android:backgroundTint="@color/white"
                android:elevation="2dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/lessonId2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFamily="@font/inter_black"
                    android:text="2"
                    android:textColor="@color/yellow3"
                    android:textSize="26sp"
                    app:layout_constraintBottom_toBottomOf="@id/nameTeacherLL2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/nameTeacherLL2" />

                <LinearLayout
                    android:id="@+id/nameTeacherLL2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toStartOf="@id/lessonTime2"
                    app:layout_constraintStart_toEndOf="@id/lessonId2"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/lessonName2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_black"
                        android:maxLines="1"
                        android:text="Математика"
                        android:textColor="@color/grey6"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/lessonTeacher2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"
                        android:text="Иванова А.А."
                        android:textColor="@color/grey3"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/lessonTime2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/inter_black"
                    android:text="13:20 — 14:50"
                    android:textColor="@color/grey5"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ============ CARD 3 (с заметкой) ============ -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/lessonItem3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/rounded_fill"
                android:backgroundTint="@color/white"
                android:elevation="2dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/lessonId3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFamily="@font/inter_black"
                    android:text="3"
                    android:textColor="@color/yellow3"
                    android:textSize="26sp"
                    app:layout_constraintBottom_toBottomOf="@id/nameTeacherLL3"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/nameTeacherLL3" />

                <LinearLayout
                    android:id="@+id/nameTeacherLL3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toStartOf="@id/lessonTime3"
                    app:layout_constraintStart_toEndOf="@id/lessonId3"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/lessonName3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_black"
                        android:maxLines="1"
                        android:text="Физика"
                        android:textColor="@color/grey6"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/lessonTeacher3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"
                        android:text="Петров П.П."
                        android:textColor="@color/grey3"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/lessonTime3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/inter_black"
                    android:text="15:00 — 16:30"
                    android:textColor="@color/grey5"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/line3"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/grey0.5"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/nameTeacherLL3" />

                <TextView
                    android:id="@+id/note3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/inter_medium"
                    android:lineSpacingExtra="2dp"
                    android:text="Какая-то очень важная заметка, йоу\nКакая-то очень важная заметка, йоу"
                    android:textColor="@color/grey4"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/line3" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ============ CARD 4 (с заметкой) ============ -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/lessonItem4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/rounded_fill"
                android:backgroundTint="@color/white"
                android:elevation="2dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/lessonId4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFamily="@font/inter_black"
                    android:text="4"
                    android:textColor="@color/yellow3"
                    android:textSize="26sp"
                    app:layout_constraintBottom_toBottomOf="@id/nameTeacherLL4"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/nameTeacherLL4" />

                <LinearLayout
                    android:id="@+id/nameTeacherLL4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toStartOf="@id/lessonTime4"
                    app:layout_constraintStart_toEndOf="@id/lessonId4"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/lessonName4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_black"
                        android:maxLines="1"
                        android:text="История"
                        android:textColor="@color/grey6"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/lessonTeacher4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"
                        android:text="Смирнов С.С."
                        android:textColor="@color/grey3"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/lessonTime4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/inter_black"
                    android:text="16:40 — 18:10"
                    android:textColor="@color/grey5"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/line4"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/grey0.5"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/nameTeacherLL4" />

                <TextView
                    android:id="@+id/note4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/inter_medium"
                    android:lineSpacingExtra="2dp"
                    android:text="Какая-то очень важная заметка, йоу"
                    android:textColor="@color/grey4"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/line4" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
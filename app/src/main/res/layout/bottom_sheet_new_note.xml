<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@color/grey1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_black"
        android:text="Новая заметка"
        android:textColor="@color/grey6"
        android:textSize="20sp" />

    <EditText
        android:id="@+id/bsTitleInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/rounded_corners"
        android:fontFamily="@font/inter_medium"
        android:hint="Название пары (например: География)"
        android:inputType="text|textCapSentences"
        android:maxLines="1"
        android:padding="14dp"
        android:textColor="@color/grey6"
        android:textColorHint="@color/grey2"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/bsTeacherInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/rounded_corners"
        android:fontFamily="@font/inter_medium"
        android:hint="Преподаватель (необязательно)"
        android:inputType="text|textCapWords"
        android:maxLines="1"
        android:padding="14dp"
        android:textColor="@color/grey6"
        android:textColorHint="@color/grey2"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/bsInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/rounded_corners"
        android:fontFamily="@font/inter_medium"
        android:gravity="top|start"
        android:hint="Текст заметки"
        android:inputType="textMultiLine|textCapSentences"
        android:minLines="3"
        android:padding="14dp"
        android:textColor="@color/grey6"
        android:textColorHint="@color/grey2"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/bsCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/rounded_corners"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_black"
            android:gravity="center"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="Отмена"
            android:textColor="@color/grey4"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/bsSave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_black"
            android:gravity="center"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="Сохранить"
            android:textColor="@color/white"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>